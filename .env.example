# Where Cotta listens on the Docker host. 127.0.0.1 = this machine only.
# Use 0.0.0.0 to reach it from your local network (trusted networks only).
COTTA_BIND=127.0.0.1
COTTA_PORT=8080

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Point the
# tunnel's public hostname at http://cotta:8080.
TUNNEL_TOKEN=

# Cloudflare Access. Set both to make Cotta refuse any request that did not
# pass Access. Team domain is the part before .cloudflareaccess.com; AUD is
# the Application Audience tag on the Access application's overview page.
COTTA_CF_TEAM_DOMAIN=
COTTA_CF_AUD=

# Sign browsers out, and lock the vault, after this long without activity.
COTTA_IDLE_LOCK=12h
